package views

templ tokensPage(view Page) {
	@shellLayout("Tokens", view.Shell) {
		@pageHeader("Personal access tokens", "A script sends a token as Authorization: Bearer <token>. The token acts as you.") {
			@primaryLink("#new-token", IconPlus, "New token")
		}
		@doneAlert(view.Notice, TokensPath)
		@errorAlert(view.Message)
		<div class="stack-lg">
			if view.TokenForm.Field != "" {
				@tokenFormCard(view.TokenForm)
			}
			<section class="card" aria-label="Tokens">
				if view.Tokens.Total > 0 {
					@searchToolbar(TokensPath, view.Tokens.Query, "Search tokens", string(view.Tokens.Filter), TokenChips)
				}
				if len(view.Tokens.Rows) > 0 {
					@tokenRows(view.Tokens.Rows)
				} else if view.Tokens.Total == 0 {
					@emptyState(IconKey, "No tokens.", "Make a token to call a protected URL from a script or a tool.") {
						@primaryLink("#new-token", IconPlus, "New token")
					}
				} else {
					@emptyState(IconSearch, "No token matches the filter.", "Change the search or the status filter.") {
						<a class="btn btn-secondary" href={ templ.SafeURL(TokensPath) }>Clear the filter</a>
					}
				}
			</section>
			if view.TokenForm.Field == "" {
				@tokenFormCard(view.TokenForm)
			}
		</div>
	}
}

templ tokenRows(rows []TokenRow) {
	<table class="table">
		<thead>
			<tr>
				<th scope="col">Name</th>
				<th scope="col">Scopes</th>
				<th scope="col">Last used</th>
				<th scope="col">Expires</th>
				<th scope="col">Status</th>
				<th scope="col" class="actions"><span class="visually-hidden">Actions</span></th>
			</tr>
		</thead>
		<tbody>
			for _, row := range rows {
				<tr>
					<td>
						<div class="cell-main">{ row.Token.Name.String() }</div>
						<div class="cell-sub"><code>{ row.Token.Prefix.String() }</code> · created <span class="num">{ Timestamp(row.Token.CreatedAt).date() }</span></div>
					</td>
					<td data-label="Scopes">
						if len(row.Token.Scopes) == 0 {
							<span class="muted">Every URL</span>
						} else {
							<div class="tags">
								for _, scope := range row.Token.Scopes {
									<code>{ scope.String() }</code>
								}
							</div>
						}
					</td>
					<td class="num" data-label="Last used">
						@timeCell(Timestamp(row.Token.LastUsedAt))
					</td>
					<td class="num" data-label="Expires">
						@timeCell(Timestamp(row.Token.ExpiresAt))
					</td>
					<td data-label="Status">
						@badge(row.Status.Tone, row.Status.Label)
					</td>
					<td class="actions">
						if !row.Token.Revoked() {
							@rowMenu(row.Token.Name.String()) {
								@confirmPost(TokensPath+"/"+row.Token.ID.String()+"/revoke", "Revoke token",
									"Revoke token “"+row.Token.Name.String()+"”? A client that sends it is refused. This cannot be undone.", "Revoke token")
							}
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
}

templ tokenFormCard(form TokenForm) {
	<section class="card" id="new-token" aria-labelledby="new-token-title">
		<div class="card-header">
			<div>
				<h2 id="new-token-title">New token</h2>
				<p>The page shows the token once, right after you make it.</p>
			</div>
		</div>
		<form method="post" action="/tokens">
			<div class="card-body">
				<div class="field">
					<label for="name"><span>Name <span class="required" aria-hidden="true">*</span></span></label>
					<input
						id="name"
						name="name"
						maxlength="64"
						required
						value={ form.Name }
						aria-describedby="name-help"
						if form.Field == TokenFieldName {
							aria-invalid="true"
							autofocus
						}
					/>
					<p class="help" id="name-help">A name you know the token by, for example "ci".</p>
					@fieldError(form, TokenFieldName)
				</div>
				<div class="field">
					<label for="scopes"><span>Scopes <span class="optional">(optional)</span></span></label>
					<textarea
						id="scopes"
						name="scopes"
						rows="3"
						aria-describedby="scopes-help"
						if form.Field == TokenFieldScopes {
							aria-invalid="true"
							autofocus
						}
					>{ form.Scopes }</textarea>
					<p class="help" id="scopes-help">One URL prefix per line, for example https://app.example.test/api/. Empty reaches every URL.</p>
					@fieldError(form, TokenFieldScopes)
				</div>
				<div class="field">
					<label for="expires"><span>Expires after <span class="optional">(optional)</span></span></label>
					<input
						id="expires"
						name="expires"
						type="date"
						value={ form.Expires }
						aria-describedby="expires-help"
						if form.Field == TokenFieldExpires {
							aria-invalid="true"
							autofocus
						}
					/>
					<p class="help" id="expires-help">The token works until the end of this day, UTC. Empty never expires.</p>
					@fieldError(form, TokenFieldExpires)
				</div>
			</div>
			<div class="card-footer">
				<a class="btn btn-secondary" href={ templ.SafeURL(TokensPath) }>Cancel</a>
				<button class="btn btn-primary" type="submit">Make token</button>
			</div>
		</form>
	</section>
}

templ fieldError(form TokenForm, field TokenField) {
	if form.Field == field {
		<p class="error-text">
			@icon(IconError)
			{ string(form.Message) }
		</p>
	}
}

templ tokenCreatedPage(view Page) {
	@shellLayout("Token made", view.Shell) {
		@breadcrumbs(TokensPath, "Tokens", "New token")
		@pageHeader("Token made", "Copy the token now and store it in a safe place.")
		<section class="card">
			<div class="card-body">
				@secretBox("You will not see this token again.") {
					<code class="secret-value">
						if view.NewToken != nil {
							{ view.NewToken.Reveal() }
						}
					</code>
					<p class="secret-help">Select the token to copy it. A client sends it as Authorization: Bearer &lt;token&gt;.</p>
				}
			</div>
			<div class="card-footer">
				<a class="btn btn-primary" href={ templ.SafeURL(TokensPath) }>Done</a>
			</div>
		</section>
	}
}
