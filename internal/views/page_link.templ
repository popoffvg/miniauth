package views

templ LinkConfirmPage(view LinkView) {
	@authLayout("Link an account") {
		@authHeading("Link an account", "Link the "+view.Provider+" account "+view.Subject.String()+" to your account "+view.Login.String()+"?")
		<div class="auth-body">
			<dl class="facts link-facts">
				<dt>Provider</dt>
				<dd><span class="cell-main">{ view.Provider }</span></dd>
				<dt>Account id</dt>
				<dd><code>{ view.Subject.String() }</code></dd>
				<dt>Your login</dt>
				<dd>{ view.Login.String() }</dd>
			</dl>
			<div class="alert alert-warning" role="note">
				@icon(IconWarning)
				<div class="alert-body">Link it only if you signed in with this { view.Provider } account yourself, in this browser. After the link, this { view.Provider } account signs in to your account.</div>
			</div>
			<form method="post" action={ templ.SafeURL(LinkPath) }>
				<input type="hidden" name="return" value={ view.Return.String() }/>
				<div class="providers">
					<button class="btn btn-primary btn-block" type="submit" name="action" value="link">Link account</button>
					<button class="btn btn-secondary btn-block" type="submit" name="action" value="skip">Skip</button>
				</div>
			</form>
		</div>
	}
}
