package api

// errorAlert shows a refused request above the form.
templ errorAlert(message pageMessage) {
	if message != "" {
		<div class="alert alert-error" role="alert">
			@icon(iconError)
			<div class="alert-body">{ string(message) }</div>
		</div>
	}
}

// doneAlert shows the result of the last change. The close link opens closePath, the page without the done flag.
templ doneAlert(message pageMessage, closePath string) {
	if message != "" {
		<div class="alert alert-success" role="status">
			@icon(iconSuccess)
			<div class="alert-body">{ string(message) }</div>
			<a class="alert-close" href={ templ.SafeURL(closePath) } aria-label="Dismiss">
				@icon(iconClose)
			</a>
		</div>
	}
}

templ badge(tone badgeTone, label string) {
	<span class={ "badge", "badge-" + string(tone) }>{ label }</span>
}

templ emptyState(glyph iconName, title string, text string) {
	<div class="empty">
		<span class="empty-icon">
			@icon(glyph)
		</span>
		<p class="empty-title">{ title }</p>
		if text != "" {
			<p>{ text }</p>
		}
		{ children... }
	</div>
}

templ primaryLink(href string, glyph iconName, label string) {
	<a class="btn btn-primary" href={ templ.SafeURL(href) }>
		@icon(glyph)
		{ label }
	</a>
}

// rowMenu is the "⋯" menu of a table row. label names the row for a screen reader.
templ rowMenu(label string) {
	<details class="menu">
		<summary class="btn btn-ghost btn-icon" aria-label={ "Actions for " + label } title="Actions">
			@icon(iconMore)
		</summary>
		<div class="menu-panel">
			{ children... }
		</div>
	</details>
}

// confirmPost reveals the danger button of a destructive POST. The first click only opens the question.
templ confirmPost(action string, item string, question string, button string) {
	<details class="confirm">
		<summary class="menu-item danger">
			@icon(iconTrash)
			{ item }
		</summary>
		<div class="confirm-box">
			<p>{ question }</p>
			<form method="post" action={ templ.SafeURL(action) }>
				<button class="btn btn-danger btn-sm" type="submit">{ button }</button>
			</form>
		</div>
	</details>
}

// confirmButton is confirmPost outside a menu: a secondary button that reveals the danger button.
templ confirmButton(action string, item string, question string, button string) {
	<details class="confirm confirm-inline">
		<summary class="btn btn-secondary">{ item }</summary>
		<div class="confirm-box">
			<p>{ question }</p>
			<form method="post" action={ templ.SafeURL(action) }>
				<button class="btn btn-danger btn-sm" type="submit">{ button }</button>
			</form>
		</div>
	</details>
}

// secretBox shows a secret once. The text selects as a whole, so a copy needs no script.
templ secretBox(warning string) {
	<div class="secret">
		<p class="secret-warning">
			@icon(iconWarning)
			{ warning }
		</p>
		{ children... }
	</div>
}

// searchToolbar is the search box and the filter chips above a table. The search is a GET of path with q.
// A page MUST show one search box: its input has the id q.
templ searchToolbar(path string, query string, label string, filter string, chips []filterChip) {
	<div class="toolbar">
		<form class="search" method="get" action={ templ.SafeURL(path) } role="search">
			<label class="visually-hidden" for="q">{ label }</label>
			<div class="search-box">
				@icon(iconSearch)
				<input id="q" name="q" type="search" value={ query } placeholder={ label }/>
			</div>
			if filter != "" {
				<input type="hidden" name="status" value={ filter }/>
			}
			<button class="btn btn-secondary btn-sm" type="submit">Search</button>
		</form>
		@filterChips(path, query, filter, chips)
	</div>
}

templ filterChips(path string, query string, filter string, chips []filterChip) {
	if len(chips) > 0 {
		<nav class="chips" aria-label="Filter">
			for _, chip := range chips {
				<a
					class="chip"
					href={ templ.SafeURL(chip.href(path, query)) }
					if chip.Value == filter {
						aria-current="true"
					}
				>{ chip.Label }</a>
			}
		</nav>
	}
}

templ timeCell(at timeText) {
	if at.Zero() {
		<span class="subtle">Never</span>
	} else {
		<time class="when num" datetime={ at.Machine() }><span>{ at.Date() }</span> <span class="when-time">{ at.Clock() }</span></time>
	}
}

templ infoAlert(message pageMessage) {
	if message != "" {
		<div class="alert" role="status">
			@icon(iconInfo)
			<div class="alert-body">{ string(message) }</div>
		</div>
	}
}
