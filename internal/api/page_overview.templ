package api

import (
	"strconv"

	"github.com/popoffvg/miniauth/internal/groups"
)

templ overviewPage(view overviewView) {
	@shellLayout("Overview", view.Shell) {
		@pageHeader("Hello, "+view.Shell.Login.String(), "Your account at a glance.")
		if view.TwoStep.Shown && !view.TwoStep.On && view.TwoStep.CanEnroll {
			<div class="alert alert-warning" role="status">
				@icon(iconShield)
				<div class="alert-body">Two-step login is off. Turn it on, so a stolen password alone cannot open your account.</div>
				<form method="post" action={ templ.SafeURL(totpEnrollPath) }>
					<button class="btn btn-secondary btn-sm" type="submit">Turn on</button>
				</form>
			</div>
		}
		<div class="stack-lg">
			<div class="grid-3">
				if view.ShowTokens {
					@statTile(tokensPath, iconKey, "Active tokens", view.ActiveTokens, "Manage tokens")
				}
				@statTile(sessionsPagePath, iconDevice, "Devices", view.Devices, "Review devices")
				if view.ShowPasskeys {
					@statTile(sessionsPagePath, iconPasskey, "Passkeys", view.Passkeys, "Manage passkeys")
				}
			</div>
			<div class="grid-2">
				<section class="card" aria-labelledby="account-title">
					<div class="card-header">
						<div>
							<h2 id="account-title">Account</h2>
							<p>You are signed in as { view.Shell.Login.String() }.</p>
						</div>
					</div>
					<div class="card-body">
						<dl class="facts">
							<dt>Login</dt>
							<dd><span class="cell-main">{ view.Shell.Login.String() }</span></dd>
							<dt>Groups</dt>
							<dd>
								for _, name := range view.Groups {
									@groupBadge(name)
								}
								if len(view.Groups) == 0 {
									<span class="subtle">No groups</span>
								}
							</dd>
							if view.TwoStep.Shown {
								<dt>Two-step login</dt>
								<dd>
									if view.TwoStep.On {
										@badge(toneOn, "On")
									} else {
										@badge(toneOff, "Off")
										<a class="small" href={ templ.SafeURL(sessionsPagePath) }>Set up</a>
									}
								</dd>
							}
						</dl>
					</div>
				</section>
				<section class="card" aria-labelledby="recent-title">
					<div class="card-header">
						<div>
							<h2 id="recent-title">Recent devices</h2>
							<p>The browsers that used your account last.</p>
						</div>
						<a class="small" href={ templ.SafeURL(sessionsPagePath) }>View all</a>
					</div>
					if len(view.RecentDevices) > 0 {
						<ul class="list">
							for _, device := range view.RecentDevices {
								<li class="list-item">
									<span class="list-icon">
										@icon(iconDevice)
									</span>
									<div class="list-main">
										<div class="cell-main">
											{ device.Name.String() }
											if device.IsCurrent {
												<span class="badge badge-current">This device</span>
											}
										</div>
										<div class="cell-sub">Last seen <span class="num">{ timeText(device.LastSeen).Human() }</span></div>
									</div>
								</li>
							}
						</ul>
					} else {
						@emptyState(iconDevice, "No device is known.", "")
					}
				</section>
			</div>
		</div>
	}
}

templ statTile(href string, glyph iconName, label string, value int, action string) {
	<a class="card stat" href={ templ.SafeURL(href) }>
		<span class="stat-label">
			@icon(glyph)
			{ label }
		</span>
		<span class="stat-value">{ strconv.Itoa(value) }</span>
		<span class="stat-link">{ action } →</span>
	</a>
}

templ groupBadge(name groups.Name) {
	if name == groups.Admins() {
		@badge(toneAdmin, name.String())
	} else {
		<span class="badge badge-plain">{ name.String() }</span>
	}
}
